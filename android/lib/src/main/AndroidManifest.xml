<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.appswithlove.debug">

    <!-- DevTrigger.Screenshot, Android 14+. Normal permission, debug artifact only. -->
    <uses-permission android:name="android.permission.DETECT_SCREEN_CAPTURE" />
    <!-- Remote reporting: send batches, wait for a (unmetered) network. Debug artifact only. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application>
        <provider
            android:name="com.appswithlove.debug.ui.component.AwlDebugFileProvider"
            android:authorities="${applicationId}.awldebug.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/awl_debug_file_paths" />
        </provider>
        <receiver
            android:name="com.appswithlove.debug.ui.dev.sheet.modules.deeplinks.DeeplinkNotificationReceiver"
            android:exported="false" />
    </application>
</manifest>
